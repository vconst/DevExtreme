{
    "extends": [
      "config:base"
    ],
    "renovateFork": true,
    "statusCheckVerify": true,
    "semanticCommits": false,
    "semanticPrefix": "chore:",
    "commitMessagePrefix": "chore:",
    "timezone": "America/Los_Angeles",
    "schedule": ["every 1 day"],
    "rangeStrategy": "bump",
    "lockFileMaintenance": { 
      "enabled": true,
      "schedule": "every 1 day"
    },
    "node": {
      "supportPolicy": ["lts_latest"]
    },
    "packageRules": [
      {
        "packagePatterns": [ "*" ],
        "excludePackagePatterns": [
          "^@types",
          "^react",
          "^inferno",
          "^jquery",
          "typescript"
        ],
        "groupName": "deps"
      },
      {
        "packagePatterns": [ "^@types" ],
        "groupName": "Types",
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "^react" ],
        "groupName": "React",
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "^inferno" ],
        "groupName": "Inferno",
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "^jquery" ],
        "groupName": "JQuery",
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packageNames": [ "typescript" ],
        "groupName": "TypeScript",
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      }
    ]
  }
