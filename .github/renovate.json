{
    "extends": [
      "config:base"
    ],
    "baseBranches": ["renovate_21_1"],
    "renovateFork": true,
    "statusCheckVerify": true,
    "semanticCommits": false,
    "semanticPrefix": "chore:",
    "commitMessagePrefix": "chore:",
    "timezone": "America/Los_Angeles",
    "schedule": ["every 2 day"],
    "rangeStrategy": "bump",
    "lockFileMaintenance": { 
      "enabled": true,
      "schedule": ["every 1 day"],
      "automerge": true
    },
    "vulnerabilityAlerts": {
      "enabled": true
    },
    "node": {
      "supportPolicy": ["lts_latest"]
    },
    "packageRules": [
      {
        "packagePatterns": [ "^inferno" ],
        "groupName": "Inferno",
        "matchUpdateTypes": ["minor", "patch"],
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "^jquery" ],
        "groupName": "JQuery",
        "matchUpdateTypes": ["minor", "patch"],
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "^react" ],
        "groupName": "React",
        "matchUpdateTypes": ["minor", "patch"],
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packageNames": [ "typescript", "^@types" ],
        "groupName": "TypeScript",
        "matchUpdateTypes": ["minor", "patch"],
        "depTypeList": [
          "dependencies",
          "devDependencies"
        ]
      },
      {
        "packagePatterns": [ "*" ],
        "groupName": "Dev Deps",
        "matchUpdateTypes": ["minor", "patch"],
        "matchDepTypes": ["devDependencies"],
        "excludePackagePatterns": [
          "^@types",
          "^react",
          "^inferno",
          "^jquery",
          "typescript"
        ]
      },
      {
        "packagePatterns": [ "*" ],
        "groupName": "Deps",
        "matchUpdateTypes": ["minor", "patch"],
        "matchDepTypes": ["dependencies"],
        "excludePackagePatterns": [
          "^@types",
          "^react",
          "^inferno",
          "^jquery",
          "typescript"
        ]
      }
    ]
  }
